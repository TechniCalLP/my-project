generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                       String                             @id @default(cuid())
  studentId                String                             @unique
  prefix                   String
  firstName                String
  lastName                 String
  year                     String
  department               String
  group                    String?
  email                    String?
  phone                    String?
  password                 String
  isActive                 Boolean                            @default(true)
  isFirstLogin             Boolean                            @default(true)
  participations           Participation[]
  vocationalActivityScores VocationalActivityScore[]
  scoreCorrectionRequests  VocationalScoreCorrectionRequest[]
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt

  @@index([studentId])
  @@index([year])
  @@index([department])
}

model Activity {
  id                String           @id @default(cuid())
  name              String
  description       String?
  category          ActivityCategory
  type              ActivityType     @default(MANDATORY)
  targetYear        String
  targetSemester    String
  targetDepartments String[]         @default([])
  startDate         DateTime
  endDate           DateTime
  location          String?
  maxSlots          Int?
  status            ActivityStatus   @default(DRAFT)
  isDeleted         Boolean          @default(false)
  deletedAt         DateTime?
  adminId           String
  admin             Admin            @relation(fields: [adminId], references: [id])
  activityCodes     ActivityCode[]
  participations    Participation[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([targetYear])
  @@index([targetSemester])
  @@index([status])
}

enum ActivityCategory {
  ACADEMIC
  COMMUNITY_SERVICE
  HEALTH
  SCOUT
}

enum ActivityType {
  MANDATORY
  OPTIONAL
}

enum ActivityStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model ActivityCode {
  id         String    @id @default(cuid())
  code       String    @unique
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  usedBy     String?
  activityId String
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([activityId])
}

model Participation {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  joinedAt   DateTime  @default(now())
  codeUsed   String

  @@unique([studentId, activityId])
  @@index([studentId])
  @@index([activityId])
}

model Admin {
  id                      String                             @id @default(cuid())
  username                String                             @unique
  password                String
  name                    String
  role                    AdminRole                          @default(ADMIN)
  isFirstLogin            Boolean                            @default(true)
  clubId                  String?
  club                    Club?                              @relation(fields: [clubId], references: [id])
  activities              Activity[]
  vocationalScoresEntered VocationalActivityScore[]
  requestedCorrections    VocationalScoreCorrectionRequest[] @relation("RequestedCorrections")
  reviewedCorrections     VocationalScoreCorrectionRequest[] @relation("ReviewedCorrections")
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt

  @@index([role])
  @@index([clubId])
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[] @default([])
  isActive  Boolean  @default(true)
  clubs     Club[]   @relation("ClubDepartments")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String               @id @default(cuid())
  name        String               @unique
  isActive    Boolean              @default(true)
  departments Department[]         @relation("ClubDepartments")
  admins      Admin[]
  activities  VocationalActivity[] @relation("VocationalActivityClubs")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model VocationalActivity {
  id                 String                             @id @default(cuid())
  name               String
  academicYear       String
  semester           String
  targetYears        String[]                           @default([])
  passThreshold      Float                              @default(60)
  clubs              Club[]                             @relation("VocationalActivityClubs")
  scores             VocationalActivityScore[]
  correctionRequests VocationalScoreCorrectionRequest[]
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt

  @@index([academicYear, semester])
}

model VocationalActivityScore {
  id                   String             @id @default(cuid())
  vocationalActivityId String
  vocationalActivity   VocationalActivity @relation(fields: [vocationalActivityId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score                Float
  isDraft              Boolean            @default(true)
  enteredById          String
  enteredBy            Admin              @relation(fields: [enteredById], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([vocationalActivityId, studentId])
  @@index([studentId])
  @@index([vocationalActivityId])
}

model VocationalScoreCorrectionRequest {
  id                   String             @id @default(cuid())
  vocationalActivityId String
  vocationalActivity   VocationalActivity @relation(fields: [vocationalActivityId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentScore         Float
  proposedScore        Float
  reason               String
  status               CorrectionStatus   @default(PENDING)
  requestedById        String
  requestedBy          Admin              @relation("RequestedCorrections", fields: [requestedById], references: [id])
  reviewedById         String?
  reviewedBy           Admin?             @relation("ReviewedCorrections", fields: [reviewedById], references: [id])
  reviewNote           String?
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())

  @@index([status])
  @@index([vocationalActivityId])
  @@index([studentId])
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model DocumentSignature {
  id        String   @id @default(cuid())
  name      String
  position  String
  imageData String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
